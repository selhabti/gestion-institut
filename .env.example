# .env.example
# Configuration d'environnement - Insitut Manager (Neon)

# Neon par institut : Auth (Managed Better Auth) + Data API (PostgREST)
# Chaque institut peut être activé/masqué en remplissant (ou non) ses 2 variables.
# Auth URL : https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth
# Data API : https://<endpoint>.apirest.<region>.aws.neon.tech/<db>/rest/v1

# --- Institut Zayed ---
VITE_INSTITUT_ZAYED_AUTH_URL=
VITE_INSTITUT_ZAYED_DATA_API_URL=

# --- Institut Attanzil ---
VITE_INSTITUT_ATTANZIL_AUTH_URL=
VITE_INSTITUT_ATTANZIL_DATA_API_URL=

# Environnement
NODE_ENV=development
VITE_APP_VERSION=1.0.0

# URLs (à configurer selon l'environnement)
VITE_APP_URL=http://localhost:8080

# Fonctionnalités
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false
